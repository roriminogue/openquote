# Copy to .env.local. Values come from the Supabase dashboard (Project Settings → API / Connect).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Drizzle connection. Use the Supavisor pooler "transaction" string (port 6543) for the app;
# drizzle-kit migrate works with it too. The password is the database password, not an API key.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Who may create a business on this install. Empty = only the first business (the owner); after that, sign-ups
# are closed. List emails and/or whole domains to let others in, e.g. "you@gmail.com, @yourbusiness.com.au".
ALLOWED_EMAILS=
# Set to true to let anyone create a business (and use the instance-wide AI key below, if set).
OPEN_SIGNUPS=

# Outgoing email (optional; Mailpit locally via docker compose, view at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# AI (SPEC.md §7a). Optional instance-wide key, used by any business that hasn't saved its own in Settings → AI.
ANTHROPIC_API_KEY=
# Estimates per business per 24 hours on that shared key (default 100; 0 = no limit). A business's own key isn't capped.
AI_DAILY_LIMIT=
# Self-hosted Ollama only: where the server reaches it (default http://localhost:11434). Businesses can't change it.
OLLAMA_BASE_URL=
# Encrypts business API keys at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# iPhone app only: the site the app opens (ios/README.md).
OPENQUOTE_APP_URL=
