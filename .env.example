# Only for development scripts; the app itself needs no settings.

# npm run ai:try / npm run bench: an Anthropic key to run the estimate pipeline from Terminal.
ANTHROPIC_API_KEY=

# scripts/export-from-web.ts: the old web version's database, to move a business onto the phone.
DATABASE_URL=

# The iPhone app's bundle identifier (also set in ios/signing.local.xcconfig).
OPENQUOTE_APP_ID=
