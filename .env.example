# Copy to .env.local for local development (matches docker-compose.yml)
DATABASE_URL=postgres://openquote:openquote@localhost:5432/openquote

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=openquote
S3_SECRET_KEY=openquote-dev
S3_BUCKET=openquote

# Outgoing email (Mailpit locally; view at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# AI
ANTHROPIC_API_KEY=
