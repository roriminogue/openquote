# Copy to .env.local. Values come from the Supabase dashboard (Project Settings → API / Connect).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side Drizzle connection. Use the Supavisor pooler "transaction" string (port 6543) for the app;
# drizzle-kit migrate works with it too. The password is the database password, not an API key.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Outgoing email (Mailpit locally via docker compose; view at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025

# AI (SPEC.md §7a). Optional instance-wide key, used by any business that hasn't saved its own in Settings → AI.
ANTHROPIC_API_KEY=
# Encrypts business API keys at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
