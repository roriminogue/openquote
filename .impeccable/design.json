      "html": "<div class=\"ds-cw\"><div class=\"ds-cc\"><textarea class=\"ds-ct\" rows=\"3\" placeholder=\"Describe the job: size, materials, access, finish.\"></textarea><div class=\"ds-cf\"><span class=\"ds-chip\">Bathroom reno</span><span class=\"ds-cm\">Anthropic</span><button class=\"ds-btn ds-btn-accent\" style=\"margin-left:auto\">Price this job</button></div></div><p class=\"ds-cs\">Site: 12 Smith St, Fitzroy</p></div>",
