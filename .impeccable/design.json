  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Near-black gradient default action: sheet submit, save, Add.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg>Add line</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;line-height:1;border:1px solid transparent;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,filter 150ms ease-out} .ds-btn:active{filter:brightness(.95)} .ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-btn-primary{background:linear-gradient(to bottom,var(--primary-top),var(--primary));border-color:var(--primary);color:var(--on-primary);box-shadow:inset 0 1px 0 rgb(255 255 255/.16)} .ds-btn-primary:hover{background:linear-gradient(to bottom,var(--primary-hover),var(--primary))}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Page-colour button with a strong hairline: Copy as text, Print or PDF, Stop.",
      "html": "<button class=\"ds-btn ds-btn-secondary\">Print or PDF</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;line-height:1;border:1px solid transparent;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,filter 150ms ease-out} .ds-btn:active{filter:brightness(.95)} .ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-btn-secondary{background:var(--bg);border-color:var(--border-strong);color:var(--ink)} .ds-btn-secondary:hover{background:var(--hover)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Cancel and Back in sheet footers; icon buttons.",
      "html": "<button class=\"ds-btn ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;line-height:1;border:1px solid transparent;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,filter 150ms ease-out} .ds-btn:active{filter:brightness(.95)} .ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-btn-ghost{background:transparent;color:var(--ink-2)} .ds-btn-ghost:hover{background:var(--hover);color:var(--ink)}"
    },
    {
      "name": "Accent Button (Price this job)",
      "kind": "button",
      "refersTo": "button-accent",
      "description": "The one orange action: starting a price. At most one per screen.",
      "html": "<button class=\"ds-btn ds-btn-accent\">Price this job<kbd class=\"ds-kbd\">⌘↵</kbd></button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border-radius:8px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;line-height:1;border:1px solid transparent;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out,color 150ms ease-out,filter 150ms ease-out} .ds-btn:active{filter:brightness(.95)} .ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-btn-accent{background:linear-gradient(to bottom,var(--accent),var(--accent-hover));border-color:var(--accent-hover);color:var(--on-accent);box-shadow:inset 0 1px 0 rgb(255 255 255/.22)} .ds-btn-accent:hover{filter:brightness(1.05)} .ds-kbd{border:1px solid color-mix(in oklab,var(--on-accent) 20%,transparent);border-radius:4px;padding:0 4px;font:500 11px/1.4 inherit;color:color-mix(in oklab,var(--on-accent) 70%,transparent)}"
    },
    {
      "name": "Field with Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Label, Optional marker, 36px input, hint.",
      "html": "<div class=\"ds-field\"><label class=\"ds-label\" for=\"ds-i\">Site address <span class=\"ds-opt\">Optional</span></label><input id=\"ds-i\" class=\"ds-input\" placeholder=\"12 Smith St, Fitzroy\"><p class=\"ds-hint\">Used for travel and local pricing.</p></div>",
      "css": ".ds-field{display:grid;gap:6px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;} .ds-label{font-size:14px;font-weight:500;color:var(--ink);display:flex;gap:6px;align-items:baseline} .ds-opt{font-weight:400;color:var(--ink-3)} .ds-input{height:36px;padding:0 12px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit;font-size:14px;transition:border-color 150ms,box-shadow 150ms} .ds-input::placeholder{color:var(--ink-3)} .ds-input:hover{border-color:var(--border-strong)} .ds-input:focus{outline:none;border-color:var(--ink-4);box-shadow:0 0 0 3px color-mix(in oklab,var(--ink) 5%,transparent)} .ds-hint{margin:0;font-size:12px;color:var(--ink-3)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "New estimate first, a small Work group label, 28px items, Settings at the foot.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><path d=\"M5 12h14M12 5v14\"/></svg>New estimate</a><p class=\"ds-nav-label\">Work</p><a class=\"ds-nav-item\" aria-current=\"page\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z\"/><path d=\"M14 3v6h6\"/></svg>Estimates</a><a class=\"ds-nav-item\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\"><path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg>Projects</a></nav>",
      "css": ".ds-nav{width:232px;padding:12px;background:var(--sidebar);font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;} .ds-nav-item{display:flex;align-items:center;gap:8px;height:28px;padding:0 8px;border-radius:8px;font-size:14px;font-weight:500;color:var(--ink);text-decoration:none;transition:background-color 150ms} .ds-nav-item:hover{background:color-mix(in oklab,var(--hover) 70%,transparent)} .ds-nav-item[aria-current=page]{background:var(--hover)} .ds-nav-item:focus-visible{outline:2px solid var(--focus);outline-offset:2px} .ds-nav-label{margin:24px 0 6px;padding:0 8px;font-size:12px;font-weight:500;color:var(--label)}"
    },
    {
      "name": "Status Badge and Source Stamps",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Grey status pills (dot only for in flight or failed) and quiet vs AI source stamps.",
      "html": "<span class=\"ds-badge\">Draft</span> <span class=\"ds-badge\"><i class=\"ds-dot\"></i>Sent</span> <span class=\"ds-stamp\">Your rate</span> <span class=\"ds-stamp ds-stamp-ai\">AI price</span>",
      "css": ".ds-badge,.ds-stamp{display:inline-flex;align-items:center;gap:6px;height:20px;padding:0 8px;border-radius:9999px;font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;font-size:12px;font-weight:500;white-space:nowrap} .ds-badge{background:var(--subtle);color:var(--ink)} .ds-dot{width:6px;height:6px;border-radius:9999px;background:var(--accent)} .ds-stamp{background:var(--subtle);color:var(--ink-3)} .ds-stamp-ai{background:transparent;border:1px dashed var(--ink-3);color:var(--ink)}"
    },
    {
      "name": "Card with Rows",
      "kind": "card",
      "refersTo": "panel",
      "description": "GroupTitle over a ring-outlined Panel of Rows split by dashed rules.",
      "html": "<section class=\"ds-group\"><h2 class=\"ds-gt\">Current setup</h2><div class=\"ds-panel\"><div class=\"ds-row\"><div><span class=\"ds-rl\">Provider</span><p class=\"ds-rh\">Where estimates are written.</p></div><span class=\"ds-rv\">Anthropic</span></div><div class=\"ds-row\"><div><span class=\"ds-rl\">API key</span><p class=\"ds-rh\">Encrypted at rest.</p></div><span class=\"ds-rv\">Your key ending 4f2a</span></div></div></section>",
      "css": ".ds-group{font-family:var(--font-geist),ui-sans-serif,system-ui,sans-serif;} .ds-gt{margin:0 0 12px;font-size:14px;font-weight:500;color:var(--ink-3)} .ds-panel{background:var(--bg);border-radius:10px;box-shadow:var(--shadow-card);padding:0 20px} .ds-row{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:20px 0} .ds-row+.ds-row{border-top:1px dashed var(--border)} .ds-rl{font-size:14px;font-weight:500;color:var(--ink)} .ds-rh{margin:2px 0 0;font-size:14px;color:var(--ink-3)} .ds-rv{font-size:14px;font-weight:500;color:var(--ink)}"
    },
    {
      "name": "Stat Columns",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Totals split by hairlines: Total inc GST as the Figure, then Your cost and Margin.",
